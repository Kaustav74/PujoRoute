// Real, Curated Registry of Kolkata Durga Puja Pandals & Bonedi Bari Houses
// Enriched with Groq AI West Bengal Subsections, Metro Connectivity & Cultural Significance.

class Pandal {
  final String id;
  final String name;
  final String category; // 'mega' or 'heritage'
  final String zone; // 'North', 'South', 'Salt Lake', 'Central'
  final String subsection; // Granular West Bengal subsection
  final double lat;
  final double lon;
  final String landmark;
  final String metroStation;
  final String history; // Rich cultural significance & heritage background
  final String gateStatus; // 'open', 'closing_soon', 'closed_for_bhog'
  final String gateClosingTime;
  final String crowdStatus; // 'fast', 'slow', 'dead_stop'
  final List<String> facilities;
  final int popularityRank;

  /// Alias for longitude to support standard geo-coordinate naming
  double get lng => lon;

  const Pandal({
    required this.id,
    required this.name,
    required this.category,
    required this.zone,
    required this.subsection,
    required this.lat,
    required this.lon,
    required this.landmark,
    required this.metroStation,
    required this.history,
    this.gateStatus = 'open',
    this.gateClosingTime = '01:30 PM (for Bhog)',
    this.crowdStatus = 'fast',
    this.facilities = const ['Clean Washroom: 100m', 'Drinking Water: 50m', 'Police Help Booth: 60m'],
    this.popularityRank = 999,
  });

  /// Factory supporting both lon and lng naming
  factory Pandal.create({
    required String id,
    required String name,
    String category = 'mega',
    required String zone,
    String subsection = '',
    required double lat,
    double? lon,
    double? lng,
    String landmark = '',
    String metroStation = '',
    String history = '',
    String gateStatus = 'open',
    String gateClosingTime = '01:30 PM (for Bhog)',
    String crowdStatus = 'fast',
    List<String> facilities = const ['Clean Washroom: 100m', 'Drinking Water: 50m', 'Police Help Booth: 60m'],
    int popularityRank = 999,
  }) {
    return Pandal(
      id: id,
      name: name,
      category: category,
      zone: zone,
      subsection: subsection,
      lat: lat,
      lon: lon ?? lng ?? 0.0,
      landmark: landmark,
      metroStation: metroStation,
      history: history,
      gateStatus: gateStatus,
      gateClosingTime: gateClosingTime,
      crowdStatus: crowdStatus,
      facilities: facilities,
      popularityRank: popularityRank,
    );
  }

  /// Detailed Metro Gate Number & Road Orientation
  String get detailedMetroGate {
    final mLower = metroStation.toLowerCase();
    if (mLower.contains('kalighat')) return 'Kalighat (Blue Line) - Gate 3 (Rashbehari Ave / Gariahat)';
    if (mLower.contains('shovabazar') || mLower.contains('sovabazar')) return 'Shovabazar Sutanuti (Blue Line) - Gate 2 (Sovabazar St)';
    if (mLower.contains('netaji bhavan')) return 'Netaji Bhavan (Blue Line) - Gate 1 (Ashutosh Mukherjee Rd / Maddox)';
    if (mLower.contains('netaji')) return 'Netaji (Kudghat) (Blue Line) - Gate 1 (Tollygunge)';
    if (mLower.contains('central')) return 'Central (Blue Line) - Gate 4 (BB Ganguly St / Mohammad Ali Park)';
    if (mLower.contains('sealdah')) return 'Sealdah (Green Line) - Gate 1 (Kole Market / College Sq walkway)';
    if (mLower.contains('rabindra sarobar')) return 'Rabindra Sarobar (Blue Line) - Gate 2 (Southern Ave / Mudiali)';
    if (mLower.contains('jatin das')) return 'Jatin Das Park (Blue Line) - Gate 2 (Hazra Crossing)';
    if (mLower.contains('karunamoyee')) return 'Karunamoyee (Green Line) - Gate 1 (Central Park & Salt Lake)';
    if (mLower.contains('bengal chemical')) return 'Bengal Chemical (Green Line) - Gate 2 (FD Block walkway)';
    if (mLower.contains('salt lake sector v') || mLower.contains('sector v')) return 'Sector V (Green Line) - Gate 3 (Wipro Crossing)';
    if (mLower.contains('dum dum')) return 'Dum Dum (Blue Line) - Gate 1 (Jessore Rd / Nagerbazar)';
    if (mLower.contains('belgachia')) return 'Belgachia (Blue Line) - Gate 1 (Belgachia Bridge)';
    if (mLower.contains('girish park')) return 'Girish Park (Blue Line) - Gate 2 (CR Avenue)';
    if (mLower.contains('mahatma gandhi') || mLower.contains('mg road')) return 'MG Road (Blue Line) - Gate 1 (College Street junction)';
    if (mLower.contains('esplanade')) return 'Esplanade (Blue/Green Line) - Gate 5 (Curzon Park)';
    if (mLower.contains('park street')) return 'Park Street (Blue Line) - Gate 1 (Park Street corridor)';
    if (mLower.contains('maidan')) return 'Maidan (Blue Line) - Gate 2 (Jawaharlal Nehru Rd)';
    if (mLower.contains('rabindra sadan')) return 'Rabindra Sadan (Blue Line) - Gate 1 (Exide Crossing / SSKM)';
    if (mLower.contains('kavi subhash') || mLower.contains('new garia')) return 'Kavi Subhash (Blue/Orange Line) - Gate 1';
    if (mLower.contains('dakshineswar')) return 'Dakshineswar (Blue Line) - Gate 2 (Temple Skywalk)';
    if (mLower.contains('shyambazar')) return 'Shyambazar (Blue Line) - Gate 1 (Five-Point Crossing)';
    if (mLower.contains('chandni')) return 'Chandni Chowk (Blue Line) - Gate 2 (Ganesh Chandra Ave)';
    if (mLower.contains('garia')) return 'Garia Bazar (Blue Line) - Gate 1 (Raja SC Mullick Rd)';
    if (mLower.contains('tollygunge') || mLower.contains('mahanayak')) return 'Mahanayak Uttam Kumar (Blue Line) - Gate 1 (Tollygunge)';
    if (mLower.contains('airport')) return 'Airport (Yellow Line) - Gate 1 (VIP Road Connector)';

    if (metroStation.contains('Gate')) return metroStation;
    return '$metroStation - Gate 1 (Main Street Concourse)';
  }

  /// Kolkata Police Barricade & One-Way Walking Route Guidance
  String get barricadeAdvisory {
    final nLower = name.toLowerCase();
    if (nLower.contains('ekdalia')) {
      return '🚨 Police One-Way: Entry strictly via Gariahat crossing barricade; exit directed into Cornfield Road. Backtracking to Gariahat is barred.';
    }
    if (nLower.contains('sreebhumi')) {
      return '🚨 Police One-Way: VIP Road pedestrian walkway active along service lane. Exit routed towards Bangur Foot Overbridge.';
    }
    if (nLower.contains('suruchi')) {
      return '🚨 Police One-Way: Approach barricaded from New Alipore petrol pump; exit directed towards Taratala road.';
    }
    if (nLower.contains('chetla')) {
      return '🚨 Police One-Way: Entry from Hazra bridge down Govinda Auddy Road; exit onto Chetla Central Road.';
    }
    if (nLower.contains('college square')) {
      return '🚨 Police One-Way: Entry from College Street main gate; exit strictly onto Surya Sen Street towards Central Ave.';
    }
    if (nLower.contains('mohammad ali')) {
      return '🚨 Police One-Way: Entry from Chittaranjan Avenue; exit into Tara Chand Dutt Street.';
    }
    if (nLower.contains('bagbazar')) {
      return '🚨 Police One-Way: One-way pedestrian lane along Bagbazar Street to Ganga riverbank; exit via Girish Avenue.';
    }
    if (nLower.contains('maddox')) {
      return 'ℹ️ Open Field: Open lawn seating; vehicular parking strictly prohibited on Ritchie Road and Lansdowne.';
    }
    if (nLower.contains('tridhara')) {
      return '🚨 Police One-Way: Entry from Monoharpukur Road; exit towards Rashbehari Avenue connector.';
    }
    if (nLower.contains('fd block')) {
      return 'ℹ️ Township Layout: Broad pedestrian boulevards; vehicle drop-off at Karunamoyee only.';
    }
    if (category == 'heritage') {
      return '🏛️ Bonedi Bari Protocol: Open courtyard Thakur Dalan darshan; queue along heritage residential lane.';
    }
    return '🚶 Standard Police Barricade: Follow dedicated entry ropeways; keep exit pathways unobstructed.';
  }

  /// Real-Time Pushpanjali and Bhog Schedule Badge
  String get ritualTimingBadge {
    final now = DateTime.now();
    final hour = now.hour;
    if (hour >= 6 && hour < 11) {
      return '🪔 Pushpanjali Cutoff: ~10:15 AM (Belur Math benchmark)';
    } else if (hour >= 12 && hour < 15) {
      return '🍲 Bhog Distribution: 1:00 PM - 2:30 PM';
    } else if (hour >= 18 && hour < 21) {
      return '🔥 Sandhya Aarati & Dhunuchi: 6:45 PM - 8:15 PM';
    } else {
      return '✨ Darshan Active • Late Night Hopping';
    }
  }
}

