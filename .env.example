# Copy to .env (never commit .env). All values are read from the environment.

# --- backend/main.py ---
APP_ENV=production                 # 'production' disables /docs and enables HSTS
FREELLMAPI_API_KEY=                # REQUIRED for AI chat. Use a NEW, rotated key.
FREELLMAPI_BASE_URL=https://my-freellmapi-server.onrender.com/v1
FREELLMAPI_MODEL=auto
ALLOWED_ORIGINS=*                  # comma-separated web origins, e.g. https://pujoroute.app
CHAT_RATE_LIMIT_PER_MIN=30
SYNC_RATE_LIMIT_PER_MIN=60
MAX_SESSIONS=20000
ENABLE_SESSION_READ=false
LOG_LEVEL=INFO
PORT=8000

# --- scripts (run_matrix_150.py, stress_test_ai.py, test_*.py, enrich_pujas_with_groq.py) ---
GROQ_API_KEY=
TARGET_API_URL=https://my-freellmapi-server.onrender.com/v1/chat/completions

# --- Cloudflare worker (set with `npx wrangler secret put <NAME>`, not here) ---
# GROQ_API_KEY, GATEWAY_SEED

# --- Flutter app (build-time only; anything passed here is extractable from the APK) ---
# flutter build appbundle --release --dart-define=FREELLMAPI_API_KEY=...
